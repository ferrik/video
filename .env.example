# Required for production:
# OPENAI_API_KEY or ANTHROPIC_API_KEY
# PEXELS_API_KEY
# ADMIN_API_KEY
# SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (only if server sync is enabled)

# Core AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_VOICE=onyx

# Voice / media
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
PEXELS_API_KEY=

# Server
PORT=3000
FFMPEG_PATH=ffmpeg
ADMIN_API_KEY=
# Public URL used to build tracked /go/:linkId affiliate links
# e.g. https://creator-os-backend-3uor.onrender.com
PUBLIC_BASE_URL=

# Supabase server-side sync
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional / frontend-facing
SUPABASE_PROJECT_URL=
SUPABASE_ANON_KEY=

# ── Amazon Affiliate (one account per market) ──────────────────────────────────
# Format: your Associates ID, e.g. "mysite-21" (UK) or "mysite-20" (US)
# Get your tag from: https://affiliate-program.amazon.co.uk → Account → Manage Tags
# Official deep link format used: /dp/ASIN/ref=nosim?tag=YOUR_TAG
AMAZON_TAG_UK=
AMAZON_TAG_US=
AMAZON_TAG_AU=
AMAZON_TAG_CA=
# Legacy fallback (used if per-market tag not set)
AMAZON_AFFILIATE_TAG=

# Winner Engine
# Jobs with >= this many clicks are flagged as winners
WINNER_CLICK_THRESHOLD=5

# Publishing / analytics
BUFFER_ACCESS_TOKEN=
YOUTUBE_API_KEY=
TIKTOK_SESSION_ID=
